# Where Sirius runs. This file is the switch: edit it by hand, then run scripts/deploy.sh.
# It is deliberately not a setting inside the app.
#
#   local   Everything stays on this laptop. No Docker, no Cloudflare, no accounts.
#   remote  The core runs in Docker, here or on another machine, and your other devices
#           reach it. See docs/DEPLOYMENT.md first.
SIRIUS_TARGET=local

# What Sirius remembers about you: one Markdown file, here inside the Obsidian vault so you can
# read and edit it there. Only the core touches it, and Obsidian does not have to be open.
# Empty keeps it in Sirius's own data folder.
SIRIUS_MEMORY_FILE=$HOME/Documents/LLMMemory/Memories/Projects/Sirius/Memory.md

# How Sirius sounds. Use a Piper voice name, or a direct https link to a voice's .onnx file with
# its .onnx.json beside it. On Hugging Face that is a /resolve/ link, not /blob/. New voices
# download when you run scripts/deploy.sh --with-voice. Pace above 1 is slower.
SIRIUS_VOICE_EN=en_US-lessac-medium
SIRIUS_VOICE_RO=ro_RO-mihai-medium
SIRIUS_VOICE_PACE=1.0

# Phone notifications through the ntfy app, as well as or instead of the phone app's own (tap
# "Turn on" on Today, which needs no extra app and is encrypted end to end). Empty means none. The free server https://ntfy.sh works with a long, random topic, such
# as https://ntfy.sh/sirius-<something only you know>, but it sees the text of each notification.
# Subscribe to the same address in the ntfy app. Self-hosting ntfy keeps the text private.
SIRIUS_NTFY_URL=

# ---- Everything below is only read when SIRIUS_TARGET=remote ----

# The address your devices will use, for example https://sirius.example.com
SIRIUS_REMOTE_URL=

# Which Docker runs the stack. Empty means this machine.
# For a homelab later: ssh://you@homelab
SIRIUS_DOCKER_HOST=

# Cloudflare Access: from your Access application. Leave empty for bearer-token only.
SIRIUS_CF_TEAM_DOMAIN=
SIRIUS_CF_AUD=


# Optional parts of the stack, comma separated: tunnel (Cloudflare), phone (ntfy)
SIRIUS_PROFILES=

# Secrets do not belong here, because this file is tracked by git. They go in infra/.env,
# which is not. Copy infra/env.example to infra/.env to start.
