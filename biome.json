{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/target",
      "!**/.cache",
      "!docs/design",
      "!**/*.gen.ts",
      "!**/*.svg",
      "!sirius-handoff",
      "!packages/core/drizzle",
      "!apps/desktop/src-tauri/gen"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "javascript": { "formatter": { "quoteStyle": "single" } },
  "linter": {
    "enabled": true,
    "rules": { "preset": "none" }
  }
}
