[Unit]
Description=Sirius voice service
After=sirius-core.service pipewire.service
# Voice is useless without the core, so it stops with it.
BindsTo=sirius-core.service

[Service]
ExecStart=%h/.local/share/sirius/voice-venv/bin/sirius-voice
# Models are fetched by the installer. At runtime nothing here may reach the network.
Environment=HF_HUB_OFFLINE=1
Environment=HF_HUB_DISABLE_TELEMETRY=1
Environment=ORT_DISABLE_TELEMETRY=1
Environment=HF_HOME=%h/.local/share/sirius/models
# scripts/install.sh writes LD_LIBRARY_PATH here when an NVIDIA GPU is usable.
EnvironmentFile=-%h/.config/sirius/voice-env
# always: voice killed on its own just comes back. Stopping the core or the unit still stops it.
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
