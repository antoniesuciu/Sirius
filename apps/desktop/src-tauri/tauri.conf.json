{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sirius",
  "version": "0.1.0",
  "identifier": "dev.sirius.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bunx vite",
    "beforeBuildCommand": "bunx vite build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sirius",
        "width": 1440,
        "height": 900,
        "minWidth": 360,
        "minHeight": 480,
        "backgroundColor": "#EBE3D1"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:7337 https:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self'",
        "img-src": "'self' data:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Productivity",
    "shortDescription": "A calm dashboard for the day",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "linux": {
      "deb": { "depends": ["libnotify-bin"] }
    }
  }
}
